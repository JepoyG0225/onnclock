# Keep disabled until sandbox onboarding, KYB, bank transfers, fee schedules,
# source-account BIC, and webhook delivery have been verified with PayMongo.
PAYMONGO_LINKED_WALLETS_ENABLED=false
PAYMONGO_SECRET_KEY=sk_test_replace_me
PAYMONGO_PARENT_ACCOUNT_ID=org_replace_me
# Generate a dedicated random secret of at least 32 characters; retain securely.
# Changing this without re-encrypting stored profiles makes them unreadable.
PAYMONGO_KYB_ENCRYPTION_KEY=
PAYMONGO_WEBHOOK_ORIGIN=https://onclockph.com
# The wallet BIC provisioned by PayMongo, used only if not returned on the wallet.
PAYMONGO_WALLET_BIC=

# Automatic collected top-ups. Requires PayMongo to settle parent QR payments
# into THIS main wallet; payouts to an external bank are deliberately rejected.
# Complete sandbox payment -> deposited payout -> company transfer testing first.
PAYMONGO_AUTOMATIC_TOPUPS_ENABLED=false
PAYMONGO_MAIN_WALLET_ID=
# Company top-ups deduct payment fees/taxes AND the forwarding transfer fee.
# Set the contracted internal PayMongo transfer fee in centavos, including tax.
# Use 0 only after confirming the internal rail is free for this account.
# No default: unknown fees block new top-ups. Each top-up pins its fee at creation.
# A differing actual provider fee requires reconciliation, never another transfer.
PAYMONGO_TOPUP_TRANSFER_FEE_CENTAVOS=
# Register checkout_session.payment.paid on the PARENT account at:
# https://onclockph.com/api/paymongo/wallet-funding
# Store its signing secret here. The existing company-wallets cron is the fallback.
PAYMONGO_FUNDING_WEBHOOK_SECRET=
# A payment without a deposited payout linked to the configured main wallet
# stays SETTLING. Instant settlement needs compatible payout evidence from
# PayMongo; elapsed time and available_at alone never establish settlement.
# Lost checkout/transfer responses: use Reconcile with cs_/btr_ from PayMongo.
# Reconciliation only reads provider records and cannot resend funds.
# Confirmed failed transfers require support reconciliation; no automatic retry.
