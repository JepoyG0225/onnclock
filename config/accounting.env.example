# Copy these settings into your server environment, never into NEXT_PUBLIC variables.
# Register these exact redirect URIs in the Intuit and Xero developer apps.
# Production uses HTTPS and production Intuit credentials/environment.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENVIRONMENT=SANDBOX
QUICKBOOKS_REDIRECT_URI=http://localhost:3001/api/integrations/oauth/quickbooks/callback
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:3001/api/integrations/oauth/xero/callback
# Generate a random secret before the first connection; keep stable and backed up.
# Existing connections encrypted using AUTH_SECRET must be reconnected if this changes.
ACCOUNTING_TOKEN_ENCRYPTION_KEY=
# Xero scope guidance: https://developer.xero.com/faq/granular-scopes
# Intuit setup: https://developer.intuit.com/app/developer/qbo/docs/develop/authentication-and-authorization/oauth-2.0
